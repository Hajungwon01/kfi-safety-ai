# 서버 포트 (uvicorn 실행 시 --port로도 지정 가능)
PORT=4000

# true(기본값): KFI 실 API 없이 로컬 mock 데이터로 동작 (개발/데모용)
# false: 아래 KFI_SERVICE_KEY로 data.go.kr 실 API 동기화(sync) 사용
USE_MOCK=true

# data.go.kr에서 발급받은 서비스키 (디코딩 버전 사용 - requests가 자동으로 URL 인코딩함)
KFI_SERVICE_KEY=

# 소방용품 품목분류코드(gdsClCd, 필수 파라미터). 콤마로 여러 개 지정 가능.
KFI_GDS_CL_CODES=01

# JWT 서명 비밀키 (운영 시 반드시 무작위 값으로 교체)
JWT_SECRET=dev-secret-change-me

# ---- 챗봇(RAG) 관련: 없어도 검색결과 폴백 모드로 정상 동작 ----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# ---- OCR (선택, public/의 브라우저 OCR은 Tesseract.js를 CDN에서 자동 로드하므로 별도 설치 불필요) ----
TESSERACT_CMD=
